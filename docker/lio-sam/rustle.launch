<launch>

    <param name="/use_sim_time" value="true"/>
    <arg name="test_type" default="simple"/>  <!-- or any default value -->
    <arg name="algo_topic" default=""/>
    <arg name="gt_topic" default=""/>
    <param name="use_sim_time" value="true" />
    <param name="algo_topic" value="$(arg algo_topic)" />
    <param name="gt_topic" value="$(arg gt_topic)" />

    <arg name="project" if="$(eval arg('test_type') != 'speed')" value="LIO-SAM"/>
    <arg name="project" if="$(eval arg('test_type') == 'speed')" value="LIO-SAM_speed"/>

    <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
        <!-- Optional arguments -->
        <arg name="port" value="57331" />
        <arg name="address" value="0.0.0.0" />
    </include>

    <!-- Parameters -->
    <rosparam file="/rustle/config/params.yaml" command="load" />
    <!--- LOAM -->
    <include file="/rustle/catkin_ws/src/$(arg project)/launch/include/module_loam.launch" />
    <!--- Robot State TF -->
    <include file="/rustle/catkin_ws/src/$(arg project)/launch/include/module_robot_state_publisher.launch"/>
    <!--- Run Navsat -->
    <include file="/rustle/catkin_ws/src/$(arg project)/launch/include/module_navsat.launch" />

    <!-- ================== LIO-SAM for the DROP TEST =========================-->
    <group if="$(eval arg('test_type') == 'drop')">
        <node pkg="rustle-ros" type="drop_manager.py" name="drop_manager" output="screen"/>
    </group>

    <!-- ================== LIO-SAM for the Cut-Off TEST ======================-->
    <group if="$(eval arg('test_type') == 'cut')">
        <node pkg="rustle-ros" type="cut_manager.py" name="cut_manager" output="screen"/>
    </group>

</launch>
